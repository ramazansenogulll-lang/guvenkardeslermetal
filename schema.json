   "mainEntity": [
    {
     "@type": "Question",
     "name": "Demir Kapı İmalatı için fiyatı nasıl öğrenirim?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "0538 933 12 72 numarasını arayın ya da işinizin fotoğrafını WhatsApp'tan gönderin. Ölçüsüne, malzemesine ve işçiliğine göre fiyatı birlikte konuşuruz."
     }
    },
    {
     "@type": "Question",
     "name": "Demir kapının fiyatını nasıl öğrenirim?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Kapı boşluğunun fotoğrafını ve yaklaşık ölçüsünü WhatsApp'tan gönderin. Ölçü, profil ve desene göre fiyatı birlikte konuşalım."
     }
    },
    {
     "@type": "Question",
     "name": "Montajı siz mi yapıyorsunuz?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Evet. Kapıyı atölyede hazırlayıp adresinizde takıyoruz."
     }
    },
    {
     "@type": "Question",
     "name": "Bursa'nın hangi ilçelerinde demir kapı imalatı yapıyorsunuz?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yıldırım, Osmangazi, Gürsu, Kestel, Nilüfer ve Mudanya ilçelerinde hizmet veriyoruz."
     }
    }
   ]
